<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Coding Riddle Agent</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.44.0/min/vs/loader.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #0d1117; color: #e6edf3; font-family: 'Segoe UI', sans-serif; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }

    /* Top bar */
    #topbar { display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; background: #161b22; border-bottom: 1px solid #30363d; }
    #topbar h2 { font-size: 15px; color: #58a6ff; }
    #score-badge { background: #238636; padding: 4px 12px; border-radius: 20px; font-size: 13px; font-weight: bold; }
    #difficulty-select { background: #21262d; color: #e6edf3; border: 1px solid #30363d; padding: 4px 8px; border-radius: 6px; font-size: 13px; }

    /* Main layout */
    #main { display: flex; flex: 1; overflow: hidden; }

    /* Left panel - problem */
    #problem-panel { width: 40%; background: #161b22; border-right: 1px solid #30363d; display: flex; flex-direction: column; overflow: hidden; }
    #problem-header { padding: 12px 16px; background: #21262d; border-bottom: 1px solid #30363d; display: flex; justify-content: space-between; align-items: center; }
    #problem-title { font-size: 14px; font-weight: bold; color: #58a6ff; }
    #problem-tags { font-size: 11px; color: #8b949e; }
    #problem-body { padding: 16px; overflow-y: auto; flex: 1; font-size: 13px; line-height: 1.7;  }
    #hint-box { padding: 12px 16px; background: #1c2128; border-top: 1px solid #30363d; font-size: 12px; color: #f0883e; display: none; }
    #hint-btn { margin: 8px 16px; padding: 6px 12px; background: #21262d; border: 1px solid #30363d; color: #8b949e; border-radius: 6px; cursor: pointer; font-size: 12px; }
    #hint-btn:hover { border-color: #58a6ff; color: #58a6ff; }

    /* Right panel - editor */
    #editor-panel { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
    #editor-topbar { display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: #161b22; border-bottom: 1px solid #30363d; }
    #lang-label { font-size: 12px; color: #8b949e; }
    #editor { flex: 1; }

    /* Bottom bar */
    #bottom-bar { display: flex; gap: 8px; padding: 10px 12px; background: #161b22; border-top: 1px solid #30363d; }
    #run-btn { flex: 1; padding: 10px; background: #238636; color: white; border: none; border-radius: 6px; font-size: 14px; font-weight: bold; cursor: pointer; }
    #run-btn:hover { background: #2ea043; }
    #next-btn { padding: 10px 16px; background: #21262d; color: #58a6ff; border: 1px solid #30363d; border-radius: 6px; font-size: 14px; cursor: pointer; }
    #next-btn:hover { border-color: #58a6ff; }

    /* Output */
    #output-panel { height: 160px; background: #0d1117; border-top: 1px solid #30363d; overflow-y: auto; padding: 12px 16px; font-size: 13px; font-family: monospace;  }
    .output-correct { color: #3fb950; }
    .output-wrong { color: #f85149; }
    .output-thinking { color: #8b949e; font-style: italic; }

    /* Loading overlay */
    #loading { position: fixed; inset: 0; background: #0d1117; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 100; }
    #loading h3 { color: #58a6ff; margin-bottom: 12px; }
    .spinner { width: 40px; height: 40px; border: 3px solid #30363d; border-top-color: #58a6ff; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body>

<div id="loading">
  <h3>Coding Riddle Agent</h3>
  <div class="spinner"></div>
  <p style="color:#8b949e; margin-top:12px; font-size:13px;">Loading your challenge...</p>
</div>

<div id="topbar">
  <h2>⚡ Coding Riddles</h2>
  <select id="difficulty-select" onchange="loadNewRiddle()">
    <option value="easy">Easy</option>
    <option value="medium" selected>Medium</option>
    <option value="hard">Hard</option>
    <option value="amazon SDE1">Amazon SDE-1</option>
    <option value="amazon SDE2">Amazon SDE-2</option>
  </select>
  <div id="score-badge">Score: <span id="score-val">0</span></div>
</div>

<div id="main">
  <div id="problem-panel">
    <div id="problem-header">
      <span id="problem-title">Problem #1</span>
      <span id="problem-tags">Arrays · Medium</span>
    </div>
    <div id="problem-body">Loading...</div>
    <button id="hint-btn" onclick="getHint()">💡 Get Hint</button>
    <div id="hint-box"></div>
  </div>

  <div id="editor-panel">
    <div id="editor-topbar">
      <span id="lang-label">Python 3</span>
      <span style="font-size:12px; color:#8b949e;">Write your solution below</span>
    </div>
    <div id="editor"></div>
    <div id="bottom-bar">
      <button id="run-btn" onclick="submitAnswer()">▶ Submit Solution</button>
      <button id="next-btn" onclick="loadNewRiddle()">Next →</button>
    </div>
    <div id="output-panel"><span class="output-thinking">Output will appear here...</span></div>
  </div>
</div>

<script>
  const API_URL = "https://yax7kpyns0.execute-api.us-east-1.amazonaws.com/riddle"; // ← replace this

  // Persistence
  let score = parseInt(localStorage.getItem("riddleScore") || "0");
  let problemCount = parseInt(localStorage.getItem("riddleProblemCount") || "1");
  let chatHistory = JSON.parse(localStorage.getItem("riddleChatHistory") || "null");
  document.getElementById("score-val").innerText = score;

  require.config({ paths: { vs: "https://cdn.jsdelivr.net/npm/monaco-editor@0.44.0/min/vs" }});
  require(["vs/editor/editor.main"], function () {
    window.editor = monaco.editor.create(document.getElementById("editor"), {
      value: "# Write your solution here\n\ndef solution():\n    pass\n",
      language: "python",
      theme: "vs-dark",
      fontSize: 14,
      minimap: { enabled: false },
      automaticLayout: true,
      scrollBeyondLastLine: false
    });
    loadNewRiddle();
  });

  async function callAgent(input) {
    const body = { input, chat_history: chatHistory };
    const res = await fetch(API_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body)
    });
    const data = await res.json();
    if (data.chat_history) {
      chatHistory = data.chat_history;
      localStorage.setItem("riddleChatHistory", JSON.stringify(chatHistory));
    }
    return data.reply;
  }

  async function loadNewRiddle() {
    document.getElementById("loading").style.display = "flex";
    document.getElementById("hint-box").style.display = "none";
    document.getElementById("output-panel").innerHTML = '<span class="output-thinking">Output will appear here...</span>';
    window.editor && window.editor.setValue("# Write your solution here\n\ndef solution():\n    pass\n");

    const difficulty = document.getElementById("difficulty-select").value;
    const prompt = `Give me a NEW ${difficulty} difficulty coding problem. Format it exactly like this:
TITLE: [short title]
TAGS: [topic tags]
PROBLEM:
[full problem description with examples, constraints, and expected input/output]
Do not give the solution yet.`;

    try {
      const reply = await callAgent(prompt);
      const titleMatch = reply.match(/TITLE:\s*(.+)/);
      const tagsMatch = reply.match(/TAGS:\s*(.+)/);
      const problemMatch = reply.match(/PROBLEM:\s*([\s\S]+)/);

      document.getElementById("problem-title").innerText =
        `Problem #${problemCount} — ${titleMatch ? titleMatch[1].trim() : "Challenge"}`;
      document.getElementById("problem-tags").innerText =
        tagsMatch ? tagsMatch[1].trim() : difficulty;
      document.getElementById("problem-body").innerHTML =
        problemMatch ? marked.parse(problemMatch[1].trim()) : marked.parse(reply);

      problemCount++;
      localStorage.setItem("riddleProblemCount", problemCount);
    } catch(e) {
      document.getElementById("problem-body").innerHTML = "Error loading problem. Check your API URL.";
    }
    document.getElementById("loading").style.display = "none";
  }

  async function submitAnswer() {
    const code = window.editor.getValue();
    document.getElementById("output-panel").innerHTML = '<span class="output-thinking">⏳ Evaluating your solution...</span>';
    document.getElementById("run-btn").disabled = true;

    try {
      const reply = await callAgent(
        `Here is my solution attempt:\n\`\`\`python\n${code}\n\`\`\`\nEvaluate it. Is it correct? Give detailed feedback, time/space complexity, and if wrong, explain why without giving the full answer.`
      );

      const isCorrect = /correct|well done|great|perfect|passes|accepted/i.test(reply);
      const isWrong = /wrong|incorrect|fails|error|not quite|off/i.test(reply);

      if (isCorrect) {
        score += 10;
        localStorage.setItem("riddleScore", score);
        document.getElementById("score-val").innerText = score;
        document.getElementById("output-panel").innerHTML =
          `<span class="output-correct">✅ Correct! +10 points\n\n${reply}</span>`;
      } else if (isWrong) {
        document.getElementById("output-panel").innerHTML =
          `<span class="output-wrong">❌ Not quite...\n\n${reply}</span>`;
      } else {
        document.getElementById("output-panel").innerHTML = reply;
      }
    } catch(e) {
      document.getElementById("output-panel").innerHTML =
        '<span class="output-wrong">Error connecting to agent.</span>';
    }
    document.getElementById("run-btn").disabled = false;
  }

  async function getHint() {
    document.getElementById("hint-box").style.display = "block";
    document.getElementById("hint-box").innerText = "💡 Getting hint...";
    const hint = await callAgent("Give me a hint for this problem without revealing the solution.");
    document.getElementById("hint-box").innerText = "💡 " + hint;
  }
</script>
</body>
</html>
